index 57425a2..bc9f43b 100644
--- a/crates/victory-shader/src/emit/wave64_tests.rs
+++ b/crates/victory-shader/src/emit/wave64_tests.rs
@@ -1014,3 +1014,150 @@ fn spilled_compute_masks_partial_dispatch_threads_on_wave64_and_wave32() {
         eprintln!("ran on the hardware device (host_wave={host_wave}): partial dispatch limits 45, 1, 0 exact");
     }
 }
+
+#[test]
+fn two_groups_with_a_partial_second_wave() {
+    let mut words = vec![
+        0x7E14_0202, // v_mov_b32 v10, s2 (group id before s2 is reused)
+        0x3414_1489, // v_lshlrev_b32 v10, 9, v10 (512 output bytes per group)
+        // Read descriptor-table offset (user_data 16) from spilled table s[0:1] + 0.
+        0x8703_FF01,
+        0x0000_00FF, // s_and_b32 s3, s1, 0xff
+        0xBE82_0300, // s_mov_b32 s2, s0
+        0x3D << 26 | 4 << 6 | 1,
+        125 << 25, // s_load_dword s4, s[2:3], 0
+        0xBE85_0380, // s_mov_b32 s5, 0
+        0x3D << 26 | 0x02 << 18 | 8 << 6 | 2,
+        125 << 25, // s_load_dwordx4 s[8:11], s[4:5], 0
+        0xBE86_107E, // s_bcnt1_i32_b64 s6, exec
+        0x7E0A_0281, // v_mov_b32 v5, 1
+        0x2C0C_0081, // v_lshrrev_b32 v6, 1, v0
+        0x340E_0B06, // v_lshlrev_b32 v7, v6, v5
+    ];
+    words.extend_from_slice(&super::wave::WAVE_OR_V7_TO_S7);
+    words.extend_from_slice(&[
+        0x3402_0083, 0x4A02_1501, // add group byte offset to v1
+        // // v_lshlrev_b32 v1, 3, v0 (lane * 8 bytes)
+        0x7E04_0206, // v_mov_b32 v2, s6 (popcnt(exec))
+        0x7E06_0207, // v_mov_b32 v3, s7 (wave OR)
+        0x38 << 26 | 0x1D << 18 | 1 << 12,
+        0x80 << 24 | 2 << 16 | 2 << 8 | 1, // buffer_store_dwordx2 v[2:3], v1, s[8:11], 0 offen
+        S_ENDPGM,
+    ]);
+    let native = NativeProgram {
+        stage: HwStage::Cs,
+        wave64: true,
+        vgprs: 16,
+        layout: vec![RootParam {
+            root: RootType::Table,
+            table_offset_dwords: 0,
+            sgprs: 1,
+            base_register: 0,
+            user_data: 16,
+            slot: 0,
+        }],
+        used: vec![UsedResource {
+            kind: ResourceType::Uav,
+            root: RootType::Table,
+            table_offset_dwords: 0,
+            lower_bound: 0,
+            stride: 0,
+            dwords: 4,
+            user_data: 16,
+            slot: 0,
+        }],
+        io: StageIo::Cs(ComputeIo {
+            rsrc2: (2 << 1) | (1 << 7), // s0..s1 spilled table pointer
+            threads: [64, 1, 1],
+        }),
+        code: words.iter().flat_map(|w| w.to_le_bytes()).collect(),
+    };
+    let p = crate::spill::build(&native).expect("spill::build");
+    let st = structure::structure(&p).expect("structure");
+    let res = resource::track(&p, &native.layout, native.stage, Some(&st)).expect("resource::track");
+    let io = io::raise(&p, &native).expect("io::raise");
+
+    let _one = super::valu_tests::ONE_AT_A_TIME.lock().unwrap_or_else(|e| e.into_inner());
+    let host = Host::new(false).ok();
+    for host_wave in [32u32] {
+        let was = lower::TEST_HOST_WAVE.replace(Some(host_wave));
+        let lowered = lower::lower(&lower::Parts {
+            native: &native,
+            p: &p,
+            st: &st,
+            io: &io,
+            res: &res,
+            inputs: Vec::new(),
+            outputs: Vec::new(),
+            prims: Vec::new(),
+            mesh_stride: 0,
+        });
+        lower::TEST_HOST_WAVE.set(was);
+        let lowered = lowered.unwrap_or_else(|e| panic!("lower (host_wave={host_wave}): {e}"));
+        assert!(
+            lowered
+                .user_data
+                .iter()
+                .any(|u| u.root == RootType::Other(super::USER_DISPATCH_THREADS) && u.dword == 0),
+            "host_wave={host_wave}: missing USER_DISPATCH_THREADS(0)"
+        );
+        let shader = HostShader {
+            stage: HwStage::Cs,
+            dxil: lowered.dxil,
+            user_data: lowered.user_data,
+            samplers: lowered.samplers,
+            static_samplers: Vec::new(),
+            root_cbvs: lowered.root_cbvs,
+            root_srvs: lowered.root_srvs,
+            root_uavs: lowered.root_uavs,
+            root_indexed_views: res.root_indexed_views.clone(),
+        };
+        if let Ok(mut v) = validator::Validator::load(validator::Validator::default_path().as_deref()) {
+            let mut copy = shader.dxil.clone();
+            v.validate(&mut copy)
+                .unwrap_or_else(|e| panic!("DXIL validation failed (host_wave={host_wave}): {e}"));
+        }
+        let host = host.as_ref().expect("hardware required");
+        let (root, pso) = host.compute_pipeline(&shader).expect("wave32 pipeline");
+        for limit in (65u32..=128).chain([0]) {
+            let mut ud = vec![0u32; shader.user_data_dwords().max(1) as usize];
+            for u in &shader.user_data {
+                if u.root == RootType::Other(super::USER_DISPATCH_THREADS) && u.dword == 0 {
+                    ud[u.index as usize] = limit;
+                }
+            }
+            let out = host
+                .dispatch(
+                    &root,
+                    &pso,
+                    &Dispatch {
+                        roots: vec![(0, Root::Constants(ud))],
+                        views: &[View::RawUav(256)],
+                        samplers: &[],
+                        groups: [2, 1, 1],
+                    },
+                )
+                .unwrap_or_else(|e| panic!("dispatch failed (host_wave={host_wave}, limit={limit}): {e}"));
+            for lane in 0..128usize {
+                let active = if limit == 0 || lane < 64 {64usize} else {(limit - 64) as usize};
+                let expected_or = (0..active).fold(0u32, |bits, i| bits | (1 << (i >> 1)));
+
+                let (got_cnt, got_or) = (out[0][lane * 2], out[0][lane * 2 + 1]);
+                if lane % 64 < active {
+                    assert_eq!(
+                        (got_cnt, got_or),
+                        (active as u32, expected_or),
+                        "host_wave={host_wave} limit={limit} lane={lane}"
+                    );
+                } else {
+                    assert_eq!(
+                        (got_cnt, got_or),
+                        (0, 0),
+                        "host_wave={host_wave} limit={limit}: inactive lane {lane} stored!"
+                    );
+                }
+            }
+        }
+        eprintln!("ran on the hardware device (host_wave={host_wave}): all 65 two-group limits checked");
+    }
+}
